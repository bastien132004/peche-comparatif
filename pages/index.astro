---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
const categories = ['Tous', ...new Set(products.map((product) => product.category))];
---
<BaseLayout title="PêcheComparatif — trouvez le bon matériel" description="Comparez cannes, moulinets et accessoires de pêche en eau douce.">
  <section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Matériel de pêche en eau douce</p><h1>Le bon équipement, <em>au bon prix.</em></h1><p class="lead">Des comparatifs clairs pour choisir une canne, un moulinet ou un leurre selon votre pratique et votre budget.</p><a class="btn btn-primary" href="#comparateur">Comparer le matériel</a></div><aside class="hero-card"><span>🏆 Choix des pêcheurs</span><strong>Shimano Stradic FM</strong><small>Le moulinet polyvalent 2025</small></aside></div></section>
  <section class="wrap comparator" id="comparateur"><div class="section-heading"><div><p class="eyebrow">Comparateur</p><h2>Les produits du moment</h2></div><p><strong id="visible-count">{products.length}</strong> produits sélectionnés</p></div><div class="filters"><input id="search" type="search" placeholder="Rechercher une marque ou un produit" aria-label="Rechercher un produit" /> <div class="filter-list">{categories.map((category) => <button class:list={['filter', { active: category === 'Tous' }]} data-filter={category}>{category}</button>)}</div></div><div id="product-grid" class="grid">{products.map((product) => <ProductCard product={product} />)}</div></section>
  <section id="guides" class="guides"><div class="wrap"><p class="eyebrow">Guides d'achat</p><h2>Bien choisir avant d'acheter</h2><div class="guide-grid"><article><span>01</span><h3>Choisir sa canne</h3><p>Longueur, puissance et action : les trois critères qui comptent.</p></article><article><span>02</span><h3>Comprendre les moulinets</h3><p>Taille, ratio et frein, sans jargon inutile.</p></article><article><span>03</span><h3>Pêcher selon son budget</h3><p>Notre sélection fiable de 30 € à 200 €.</p></article></div></div></section>
  <section id="apropos" class="wrap about"><div><p class="eyebrow">Notre méthode</p><h2>Des recommandations simples et transparentes.</h2></div><p>Nous sélectionnons le matériel selon son rapport qualité-prix, les retours de pêcheurs et l'usage réel. Les prix affichés sont indicatifs : vérifiez toujours l'offre avant commande.</p></section>
  <div class="compare-bar" id="compare-bar" hidden><div class="wrap"><span id="compare-count">0 produit sélectionné</span><span id="compare-names"></span><button class="btn btn-secondary" id="clear-compare">Vider</button></div></div>
</BaseLayout>
<style>
  .hero { padding:76px 0; background:linear-gradient(120deg,#eaf4df,#f8faf6 58%,#d9efd0); } .hero-grid { display:grid; grid-template-columns:1.4fr .8fr; align-items:center; gap:48px; } .eyebrow { color:var(--green); font-size:.78rem; text-transform:uppercase; font-weight:850; letter-spacing:.11em; margin:0 0 10px; } h1,h2 { letter-spacing:-.04em; } h1 { max-width:650px; margin:0; font-size:clamp(2.6rem,6vw,5rem); line-height:1; } h1 em { color:var(--green); font-style:normal; } .lead { max-width:600px; color:var(--muted); font-size:1.12rem; margin:22px 0 28px; }.hero-card { background:#173923; color:#fff; border-radius:16px; padding:30px; display:flex; flex-direction:column; gap:8px; box-shadow:0 22px 40px #17392326; }.hero-card span { color:var(--lime); font-size:.85rem; font-weight:800; }.hero-card strong { font-size:1.45rem; }.hero-card small { color:#bdd0c1; }.comparator { padding:70px 0; }.section-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; }.section-heading h2,.guides h2,.about h2 { margin:0; font-size:clamp(1.8rem,3vw,2.7rem); }.section-heading > p { color:var(--muted); }.filters { margin:28px 0; display:flex; gap:12px; align-items:center; flex-wrap:wrap; }.filters input { min-width:240px; flex:1; padding:12px 14px; border:1px solid var(--line); border-radius:9px; font:inherit; }.filter-list { display:flex; gap:7px; flex-wrap:wrap; }.filter { padding:9px 12px; cursor:pointer; border:1px solid var(--line); border-radius:999px; background:#fff; font:inherit; font-weight:700; }.filter.active { background:var(--green); color:#fff; border-color:var(--green); }.grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }.guides { background:#eaf4df; padding:70px 0; }.guide-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:28px; }.guide-grid article { background:#fff; border-radius:12px; padding:22px; }.guide-grid span { color:var(--green); font-weight:900; }.guide-grid h3 { margin-bottom:8px; }.guide-grid p,.about > p { color:var(--muted); }.about { padding:70px 0; display:grid; grid-template-columns:1fr 1fr; gap:48px; }.compare-bar { position:fixed; z-index:6; bottom:18px; left:16px; right:16px; }.compare-bar > div { background:#14251c; color:#fff; border-radius:12px; padding:12px 16px; display:flex; align-items:center; gap:16px; box-shadow:0 15px 40px #14251c55; }.compare-bar #compare-names { color:#c8ed5a; flex:1; font-size:.9rem; }.compare-bar .btn { padding:8px 12px; } @media(max-width:780px) { .hero-grid,.about { grid-template-columns:1fr; }.grid,.guide-grid { grid-template-columns:repeat(2,1fr); } } @media(max-width:540px) { .grid,.guide-grid { grid-template-columns:1fr; }.hero { padding:54px 0; }.compare-bar #compare-names { display:none; } }
</style>
<script>
  const selected = new Map<string, string>();
  const cards = [...document.querySelectorAll<HTMLElement>('.product')];
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const count = document.querySelector('#visible-count')!;
  const compareBar = document.querySelector<HTMLElement>('#compare-bar')!;
  const compareCount = document.querySelector('#compare-count')!;
  const compareNames = document.querySelector('#compare-names')!;
  let category = 'Tous';
  function filterProducts() { const query = search.value.toLowerCase().trim(); let shown = 0; cards.forEach((card) => { const matches = (category === 'Tous' || card.dataset.category === category) && (card.dataset.name?.includes(query) ?? false); card.hidden = !matches; if (matches) shown++; }); count.textContent = String(shown); }
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach((button) => button.addEventListener('click', () => { category = button.dataset.filter!; document.querySelectorAll('.filter').forEach((item) => item.classList.toggle('active', item === button)); filterProducts(); }));
  search.addEventListener('input', filterProducts);
  document.querySelectorAll<HTMLButtonElement>('.compare-toggle').forEach((button) => button.addEventListener('click', () => { const id = button.dataset.productId!; const name = button.dataset.productName!; if (selected.has(id)) { selected.delete(id); button.textContent = '+ Comparer'; button.classList.remove('selected'); } else { selected.set(id, name); button.textContent = '✓ Ajouté'; button.classList.add('selected'); } compareBar.hidden = selected.size === 0; compareCount.textContent = `${selected.size} produit${selected.size > 1 ? 's' : ''} sélectionné${selected.size > 1 ? 's' : ''}`; compareNames.textContent = [...selected.values()].join(' · '); }));
  document.querySelector('#clear-compare')?.addEventListener('click', () => { selected.clear(); document.querySelectorAll('.compare-toggle').forEach((button) => { button.textContent = '+ Comparer'; button.classList.remove('selected'); }); compareBar.hidden = true; });
</script>
